checkpoints/
checkpoints_modal/
*.pt
*.ckpt
*.safetensors

# Eval artifacts
eval/results/

# Frontend
frontend/node_modules/
frontend/dist/
frontend/*.tsbuildinfo

# Editor / OS
.DS_Store
.vscode/
.idea/
*.swp

# MCSim local SQLite — predictions + actuals + model_versions. Single-file DB
# bootstraps from mcsim.storage.init_db() on first call.
data/mcsim.sqlite
data/mcsim.sqlite-journal
